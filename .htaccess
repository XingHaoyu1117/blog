# Apache 2.4 hardening. Nginx users must apply equivalent location rules in server config.
Options -Indexes

<FilesMatch "^(config\.php|config\.example\.php)$">
    Require all denied
</FilesMatch>

<FilesMatch "^\.(env|git|htaccess|htpasswd)">
    Require all denied
</FilesMatch>

<FilesMatch "^(composer\.(json|lock)|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>

ErrorDocument 404 /404.php
